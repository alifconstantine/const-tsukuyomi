{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "bluetooth", "wireplumber", "battery", "custom/screenshot", "tray", "custom/power"],
    "custom/launcher": {
        "format": "Apps",
        "tooltip-format": "Open apps · Super+Space",
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "all-outputs": false
    },
    "clock": {
        "format": "{:%a %d %b · %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "network": {
        "format-wifi": "Wi-Fi {signalStrength}%",
        "format-ethernet": "Ethernet",
        "format-disconnected": "Disconnected",
        "tooltip-format": "{ifname} · {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "Bluetooth",
        "format-disabled": "Bluetooth off",
        "format-connected": "Bluetooth {num_connections}",
        "tooltip-format": "{controller_alias}",
        "on-click": "blueman-manager"
    },
    "wireplumber": {
        "format": "Audio {volume}%",
        "format-muted": "Audio muted",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "battery": {
        "states": {"warning": 30, "critical": 15},
        "format": "Battery {capacity}%",
        "format-charging": "Charging {capacity}%",
        "format-plugged": "AC power {capacity}%",
        "tooltip-format": "{timeTo}"
    },
    "custom/screenshot": {
        "format": "Screenshot",
        "tooltip-format": "Click: select area · Right-click: entire desktop",
        "on-click": "constos-screenshot region",
        "on-click-right": "constos-screenshot screen"
    },
    "tray": {"spacing": 8},
    "custom/power": {
        "format": "Power",
        "tooltip-format": "Lock, sign out, shut down, or restart",
        "on-click": "wlogout"
    }
}
