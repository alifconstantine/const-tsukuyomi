{
    "label": "lock",
    "action": "constos-lock",
    "text": "Lock Screen",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprctl dispatch 'hl.dsp.exit()'",
    "text": "Sign Out",
    "keybind": "e"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shut Down",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Restart",
    "keybind": "r"
}
