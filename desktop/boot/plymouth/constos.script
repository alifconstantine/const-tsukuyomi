# Adaptasi terminal boot Tsukuyomi; callback Plymouth memakai progres nyata.
# Bagian interaksi kata sandi berasal dari Ryoku v1.0.7 (GPL-3.0).
Window.SetBackgroundTopColor(0.071, 0.055, 0.067);
Window.SetBackgroundBottomColor(0.071, 0.055, 0.067);
global.status_text = "Waiting for the graphical session...";
global.boot_fraction = 0;
global.password_active = 0;

prompt.image = Image.Text("tsukuyomi@boot:~$ systemctl start graphical.target", 0.776, 0.420, 0.463);
prompt.sprite = Sprite(prompt.image);
prompt.x = Window.GetWidth() / 2 - prompt.image.GetWidth() / 2;
if (prompt.x < 24) prompt.x = 24;
prompt.y = Window.GetHeight() / 2 - 64;
prompt.sprite.SetPosition(prompt.x, prompt.y, 1);
status.sprite = Sprite();
progress.sprite = Sprite();

fun render_status() {
    status.image = Image.Text(global.status_text, 0.776, 0.714, 0.737);
    status.sprite.SetImage(status.image);
    status.sprite.SetPosition(prompt.x, prompt.y + 42, 1);
    bar = "[";
    filled = Math.Int(global.boot_fraction * 28);
    for (i = 0; i < 28; i++) {
        if (i < filled) bar += "#";
        else bar += "-";
    }
    bar += "]  " + Math.Int(global.boot_fraction * 100) + "%";
    progress.sprite.SetImage(Image.Text(bar, 0.776, 0.420, 0.463));
    progress.sprite.SetPosition(prompt.x, prompt.y + 80, 1);
}
fun progress_callback(duration, progress) {
    if (global.password_active == 0) {
        if (Math.Int(progress * 100) > Math.Int(global.boot_fraction * 100)) {
            global.boot_fraction = progress;
            render_status();
        }
    }
}
fun update_callback(text) {
    if (global.password_active == 0) {
        global.status_text = text;
        render_status();
    }
}
fun password_callback(text, bullets) {
    global.password_active = 1;
    masked = "";
    for (i = 0; i < bullets; i++) masked += "*";
    global.status_text = text + "  " + masked;
    render_status();
}
fun normal_callback() {
    global.password_active = 0;
    global.status_text = "Waiting for the graphical session...";
    render_status();
}
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetUpdateStatusFunction(update_callback);
Plymouth.SetDisplayMessageFunction(update_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
render_status();
