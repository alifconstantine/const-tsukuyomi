---
componentName: constos
welcomeStyleCalamares: false
welcomeExpandingLogo: false
windowExpanding: fullscreen
windowPlacement: center
# Required by the pinned branding loader even when the execution view lists jobs.
slideshow: [ logo.svg ]

strings:
    productName:         ConstOS
    version:             Alpha
    shortVersion:        Alpha
    versionedName:       ConstOS Alpha
    shortVersionedName:  ConstOS
    bootloaderEntryName: ConstOS
    productUrl:          https://github.com/alifconstantine/const-tsukuyomi
    supportUrl:          https://github.com/alifconstantine/const-tsukuyomi/issues
    knownIssuesUrl:      https://github.com/alifconstantine/const-tsukuyomi/issues
    releaseNotesUrl:     https://github.com/alifconstantine/const-tsukuyomi/releases

images:
    productLogo:         "logo.svg"
    productIcon:         "constos.svg"
    productWelcome:      "logo.svg"

style:
   SidebarBackground:    "#161616"
   SidebarText:          "#FFFFFF"
   SidebarTextCurrent:   "#FFFFFF"
   SidebarBackgroundCurrent: "#262626"
