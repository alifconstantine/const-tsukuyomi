Subject: [ConstOS] Link the Python API against Qt Widgets

The pinned CachyOS fork implements Python show_warning() with QMessageBox.
Declare the library dependency so the API has both the Widgets include path
and linkage; retaining the API without its dependency fails compilation.

diff --git a/src/libcalamares/CMakeLists.txt b/src/libcalamares/CMakeLists.txt
--- a/src/libcalamares/CMakeLists.txt
+++ b/src/libcalamares/CMakeLists.txt
@@ -135,6 +135,7 @@ if(WITH_PYTHON)
         target_link_libraries(calamares PRIVATE Python::Python Boost::python)
     endif()
     target_sources(calamares PRIVATE python/Api.cpp python/Variant.cpp)
+    target_link_libraries(calamares PRIVATE ${qtname}::Widgets)
 endif()
 
