{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "white",
      "2": "white"
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "ConstOS (Harness Edition) [CachyOS Based]"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release} (BORE Scheduler)"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "wm",
      "key": "Compositor",
      "format": "Hyprland (Wayland)"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "RAM (ZRAM Enabled)"
    },
    {
      "type": "disk",
      "key": "Disk (Btrfs CoW)"
    },
    "break",
    "colors"
  ]
}
