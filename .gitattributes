# Auto-detect text files and normalize line endings to LF (Linux standard)
* text=auto eol=lf

# Explicit bash/shell scripts
*.sh text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
profiledef.sh text eol=lf
PKGBUILD text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.tar.* binary
*.iso binary
